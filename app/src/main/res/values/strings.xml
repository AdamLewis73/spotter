<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher label. The Play Store title is "Spotter: Kanji Scanner" (D-63),
         but the launcher shows the brand alone — the subtitle is a store
         listing device, not part of the name. -->
    <string name="app_name">Spotter</string>

    <!-- Scan screen -->
    <string name="scan_shutter">Take photo</string>
    <string name="scan_retake">Retake</string>
    <string name="scan_frozen_photo">Captured photo</string>
    <string name="scan_open_lookup">Look up a word by typing</string>

    <!-- Camera permission. `ux.md` wants the premise explained before the ask,
         because a viewfinder alone reads as a translator. That onboarding is a
         later job; this rationale is the short version of it, and it says what
         the camera is FOR rather than that the app needs it. -->
    <string name="scan_permission_title">Point at Japanese text</string>
    <string name="scan_permission_body">Spotter reads the words in a photo and shows you what they mean, so it needs the camera.\n\nPhotos stay on your device.</string>
    <string name="scan_permission_grant">Allow camera</string>
    <string name="scan_permission_denied_body">Camera access is turned off. You can turn it back on in Settings, under Permissions.</string>
    <string name="scan_permission_settings">Open settings</string>

    <!-- Stage 2, the frozen frame. "Reading" rather than "Scanning" or
         "Processing": the app is reading the sign, which is the thing the user
         came to have done, and it is what they would say themselves. -->
    <string name="scan_reading">Reading…</string>
    <string name="scan_no_text">No Japanese text found here</string>
    <string name="scan_recognize_failed">That photo could not be read. Try again.</string>
    <string name="scan_tap_to_look_up">Tap to look these words up</string>
    <string name="scan_tap_a_word">Tap a word</string>
    <string name="scan_peek_save">Save</string>
    <!-- The same button once the word is saved; tapping it again unsaves. -->
    <string name="scan_peek_saved">Saved</string>
    <string name="scan_peek_full_details">Full details</string>
    <string name="scan_peek_looking_up">Looking up…</string>
    <string name="scan_peek_not_found">Not in the dictionary</string>
    <string name="scan_overlay">Recognized text. Tap a word to look it up.</string>

    <string name="scan_no_camera">This device has no camera Spotter can use.</string>
    <string name="scan_camera_failed">The camera could not be started.</string>
    <string name="scan_capture_failed">That photo could not be taken. Try again.</string>
</resources>
